# Copy this file to ".env" and fill in your own values.
# ".env" is git-ignored, so your password never reaches GitHub.

# PostgreSQL connection: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# If your password contains special characters, URL-encode them
# (for example @ -> %40, # -> %23, / -> %2F, : -> %3A).
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/placement_db

# Secret key used to sign login sessions (JWT). Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# and paste the output here. The app refuses to start with this example value.
JWT_SECRET=replace-with-a-long-random-string
